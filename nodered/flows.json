    "func": "// Alerta del ESP32 (mismo formato de la colección eventos) + fecha del servidor\nconst ev = (typeof msg.payload === 'object' && msg.payload) ? msg.payload : { tipo: 'desconocido', crudo: String(msg.payload) };\nev.origen = 'esp32';\nev.fecha = new Date();\nconst TXT = { alerta_gas: '🔥 Gas sobre el umbral', fuga_agua: '💧 Fuga de agua', puerta_abierta: '🚨 Intrusión: puerta abierta con seguridad' };\nconst aviso = `${TXT[ev.tipo] || ev.tipo} (${ev.sensor || ''}: ${ev.valor ?? ''})`;\nreturn [{ payload: ev }, { payload: aviso, topic: 'Alerta' }, { payload: ev }, { payload: aviso }];\n",
