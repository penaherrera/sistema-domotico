  {
    "id": "a_mongo_prep",
    "type": "function",
    "z": "tab_actuadores",
    "name": "Documentos estado",
    "func": "// Solo actualiza MongoDB cuando el estado cambia\nconst e = msg.payload;\nif (typeof e !== 'object' || e === null) return null;\nconst clave = JSON.stringify(e);\nif (context.get('ultimo') === clave) return null;\ncontext.set('ultimo', clave);\nconst ahora = new Date();\nconst est = (v) => v === 'on' ? 'encendido' : 'apagado';\nconst doc = (id, set) => ({ query: { _id: id }, payload: { $set: Object.assign(set, { modo: e.modo, actualizado: ahora }) } });\nreturn [[\n    doc('rele',       { estado: est(e.rele) }),\n    doc('buzzer',     { estado: est(e.buzzer) }),\n    doc('ventilador', { estado: est(e.ventilador) }),\n    doc('servo',      { angulo: Number(e.servo) }),\n    doc('sistema',    { seguridad: e.seguridad === 'on' })\n]];\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
