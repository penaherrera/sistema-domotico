    "func": "// online/offline retenido; el broker publica 'offline' (LWT) si el ESP32 se cae\nconst online = msg.payload === 'online';\nconst prev = context.get('prev');\ncontext.set('prev', msg.payload);\nnode.status({ fill: online ? 'green' : 'red', shape: 'dot', text: msg.payload });\nconst texto = { payload: online ? '🟢 En línea' : '🔴 Desconectado' };\nif (prev === msg.payload) return [texto, null, null, null];\nconst ev = { tipo: online ? 'esp32_online' : 'esp32_offline', origen: 'broker', fecha: new Date() };\nconst aviso = online ? null : { payload: 'El ESP32 se desconectó (LWT recibido)', topic: 'ESP32' };\nreturn [texto, aviso, { payload: ev }, { payload: ev }];\n",
