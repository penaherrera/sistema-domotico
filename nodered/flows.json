  {
    "id": "e_tabla_fmt",
    "type": "function",
    "z": "tab_eventos",
    "name": "Filas de la tabla",
    "func": "// Mantiene las últimas 15 filas para las tablas del dashboard\nconst e = msg.payload;\nconst f = e.fecha instanceof Date ? e.fecha : new Date(e.fecha);\nlet detalle = '';\nif (e.valor !== undefined) detalle = `valor ${e.valor}` + (e.umbral !== undefined ? ` / umbral ${e.umbral}` : '');\nif (e.detalle) detalle = e.detalle;\nif (e.actuador) detalle = `${e.actuador} = ${e.valor}`;\nconst fila = {\n    Hora: f.toLocaleString('es-SV', { timeZone: 'America/El_Salvador', hour12: false,\n                                      day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' }),\n    Tipo: e.tipo, Sensor: e.sensor || e.actuador || '-', Detalle: detalle || '-'\n};\nlet filas = flow.get('filas') || [];\nif (msg.reemplazar) filas = [];\nfilas.unshift(fila);\nfilas = filas.slice(0, 15);\nflow.set('filas', filas);\nreturn [{ payload: filas.slice(0, 6) }, { payload: filas }];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
