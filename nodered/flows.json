  {
    "id": "c1",
    "type": "comment",
    "z": "tab_sensores",
    "name": "Telemetría ESP32 → validación → dashboard + PostgreSQL",
    "info": "Cada 5 s el ESP32 publica casa/sensores/{temperatura,humedad,gas,agua,puerta}.\nSe valida el rango en el servidor (segunda barrera además de la del ESP32) antes de guardar.",
    "x": 230,
    "y": 40,
    "wires": []
  },
  {
    "id": "s_in",
    "type": "mqtt in",
    "z": "tab_sensores",
    "name": "Sensores",
    "topic": "casa/sensores/+",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "cfg_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 140,
    "wires": [
      [
        "s_val"
      ]
    ]
  },
  {
    "id": "s_val",
    "type": "function",
    "z": "tab_sensores",
    "name": "Validar rango",
    "func": "// Validación en el servidor: tipo numérico y rango físico del sensor\nconst variable = msg.topic.split('/').pop();\nconst META = {\n    temperatura: { sensor: 'DHT11',  unidad: '°C',     min: 0, max: 50,   serie: 'Temperatura (°C)' },\n    humedad:     { sensor: 'DHT11',  unidad: '%',      min: 0, max: 100,  serie: 'Humedad (%)' },\n    gas:         { sensor: 'MQ2',    unidad: 'indice', min: 0, max: 1000, serie: 'Gas MQ-2' },\n    agua:        { sensor: 'KS0048', unidad: '%',      min: 0, max: 100,  serie: 'Agua (%)' },\n    puerta:      { sensor: 'KS0038', unidad: 'estado', min: 0, max: 1,    serie: 'Puerta' }\n};\nconst m = META[variable];\nconst valor = Number(msg.payload);\n\nif (!m || typeof msg.payload === 'object' || !Number.isFinite(valor) ||\n    valor < m.min || valor > m.max) {\n    node.status({ fill: 'red', shape: 'dot', text: `descartado ${variable}=${msg.payload}` });\n    return [null, { payload: { tipo: 'lectura_invalida', origen: 'nodered', topico: msg.topic,\n                               sensor: m ? m.sensor : variable, valor: String(msg.payload),\n                               detalle: `${variable} fuera de rango: ${msg.payload}`, fecha: new Date() } }];\n}\n\nmsg.variable = variable;\nmsg.sensor = m.sensor;\nmsg.unidad = m.unidad;\nmsg.serie = m.serie;\nmsg.payload = Math.round(valor * 100) / 100;\nnode.status({ fill: 'green', shape: 'dot', text: `${variable} = ${msg.payload}` });\nreturn [msg, null];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 140,
    "wires": [
      [
        "s_sw",
        "s_sql",
        "s_hora",
        "s_wd"
      ],
      [
        "s_inv",
        "s_inv_mongo"
      ]
    ],
    "info": ""
  },
  {
    "id": "s_sw",
    "type": "switch",
    "z": "tab_sensores",
    "name": "Por variable",
    "property": "variable",
