    "id": "a_split",
    "type": "function",
    "z": "tab_actuadores",
    "name": "Repartir estado",
    "func": "// Reparte el JSON del ESP32 a cada control del dashboard\nconst e = msg.payload;\nif (typeof e !== 'object' || e === null) { node.warn('estado no válido'); return null; }\nconst manual = e.modo === 'manual';\n// En modo auto el ESP32 ignora las órdenes: se deshabilitan los controles\nconst ctl = (v) => ({ payload: v, enabled: manual });\nnode.status({ fill: manual ? 'yellow' : 'green', shape: 'dot', text: `modo ${e.modo}, seguridad ${e.seguridad}` });\nreturn [\n    ctl(e.rele), ctl(e.buzzer), ctl(e.ventilador), ctl(Number(e.servo)),\n    { payload: e.modo },\n    { payload: e.seguridad },\n    { payload: manual ? '✋ Manual (órdenes del dashboard)' : '🤖 Automático (reglas del ESP32)' },\n    { payload: e.seguridad === 'on' ? '🛡️ Activado' : 'Desactivado' }\n];\n",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
